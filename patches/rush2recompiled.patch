+            if (p == nullptr) {
+                return;
+            }
+            recomp::config::Config& config = recompui::config::get_config(config_id);
+            for (const std::string& id : option_ids()) {
+                config.set_option_value(id, valid_or_default(config.get_option(id), value_in(*p, id)));
+            }
+            config.save_config();
+            active = name;
+            save();
+        }
