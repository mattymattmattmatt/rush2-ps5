+            if (!in.is_object()) {
+                return;
+            }
+            if (in.contains("profiles") && in["profiles"].is_array()) {
+                for (const auto& entry : in["profiles"]) {
+                    if (!entry.is_object() || !entry.contains("name") || !entry["name"].is_string()) {
+                        continue;
+                    }
+                    Profile p{ entry["name"].get<std::string>() };
+                    if (p.name.empty() || find_profile(p.name) != nullptr) {
+                        continue;
+                    }
+                    if (entry.contains("options") && entry["options"].is_object()) {
+                        for (const auto& [id, value] : entry["options"].items()) {
+                            if (value.is_boolean()) {
+                                p.values.emplace_back(id, value.get<bool>());
+                            }
+                            else if (value.is_number_unsigned()) {
+                                p.values.emplace_back(id, value.get<uint32_t>());
+                            }
+                        }
+                    }
+                    list.push_back(std::move(p));
+                }
+            }
+            if (in.contains("active") && in["active"].is_string()) {
+                std::string name = in["active"].get<std::string>();
+                if (find_profile(name) != nullptr) {
