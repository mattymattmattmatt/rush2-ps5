diff --git a/CMakeLists.txt b/CMakeLists.txt
index 741aa0a..c9f2ead 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,6 +40,11 @@ add_compile_definitions(
 # a submodule, write its patch again with `python tools/lib_patch.py save` before committing.
 find_package(Git REQUIRED)
 file(GLOB LIB_PATCHES "${CMAKE_SOURCE_DIR}/lib/patches/*.patch")
+if (PS5)
+    # The PS5 port's tools/setup-source.sh applies these and commits them in each submodule. The port's own patches
+    # change some of the same lines, which the check below takes for a patch that isn't applied.
+    set(LIB_PATCHES "")
+endif()
 foreach(LIB_PATCH ${LIB_PATCHES})
     get_filename_component(LIB_NAME ${LIB_PATCH} NAME_WE)
     set(LIB_DIR "${CMAKE_SOURCE_DIR}/lib/${LIB_NAME}")
@@ -108,6 +113,10 @@ target_sources(RecompiledFuncs PRIVATE ${FUNC_C_SOURCES} ${FUNC_CXX_SOURCES})
 
 # Main executable
 add_executable(Rush2Recompiled)
+if (PS5)
+    target_sources(Rush2Recompiled PRIVATE "${RUSH2_PS5_DIR}/ps5_platform.cpp")
+    target_include_directories(Rush2Recompiled PRIVATE "${RUSH2_PS5_DIR}")
+endif()
 
 # The version shown in the launcher is the latest git tag (v1.0.8 -> 1.0.8), read when CMake configures; 0.1.0 without one.
 set(RUSH2_VERSION "0.1.0")
